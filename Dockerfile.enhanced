# LanLens Enhanced v5
# Builds from the preserved LanLens v1.5.9 source tree, then applies the enhancement layer.

# ─── Stage 1: Build React frontend from upstream source ───────────────────────
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

ARG LANLENS_APP_VERSION=1.5.9
ARG LANLENS_BUILD_CODE=enhanced-v5
ARG LANLENS_BUILD_COMMIT=unknown
ARG LANLENS_BUILD_BRANCH=LanLens-Enhanced
ARG LANLENS_BUILD_CREATED=unknown

COPY upstream/frontend/package.json ./
COPY upstream/frontend/package-lock.json* ./
RUN [ -f package-lock.json ] && npm ci --silent || npm install --silent

COPY upstream/frontend/ ./
RUN printf "export const APP_VERSION = '%s'\nexport const GITHUB_REPO = 'haochen1204/LanLens-Enhanced'\nexport const BUILD_CODE = '%s'\nexport const BUILD_COMMIT = '%s'\nexport const BUILD_BRANCH = '%s'\nexport const BUILD_CREATED = '%s'\n" \
    "$LANLENS_APP_VERSION" \
    "$LANLENS_BUILD_CODE" \
    "$LANLENS_BUILD_COMMIT" \
    "$LANLENS_BUILD_BRANCH" \
    "$LANLENS_BUILD_CREATED" \
    > src/version.ts
RUN npm run build

# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim

ARG LANLENS_APP_VERSION=1.5.9
ARG LANLENS_BUILD_CODE=enhanced-v5
ARG LANLENS_BUILD_COMMIT=unknown
ARG LANLENS_BUILD_BRANCH=LanLens-Enhanced
ARG LANLENS_BUILD_CREATED=unknown

LABEL org.opencontainers.image.title="LanLens Enhanced" \
      org.opencontainers.image.description="LanLens v1.5.9 with automatic service discovery, port state tracking and Chinese notifications" \
      org.opencontainers.image.version=$LANLENS_APP_VERSION \
      org.opencontainers.image.revision=$LANLENS_BUILD_COMMIT \
      org.opencontainers.image.created=$LANLENS_BUILD_CREATED \
      org.opencontainers.image.source="https://github.com/haochen1204/LanLens-Enhanced" \
      org.opencontainers.image.base.name="AlexRosbach/LanLens v1.5.9"

COPY upstream/backend/requirements.txt /tmp/requirements.txt
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    nmap \
    iputils-ping \
    snmp \
    libpcap-dev \
    libpcap0.8 \
    net-tools \
    iproute2 \
    curl \
    gcc \
    python3-dev \
  && rm -f /etc/nginx/sites-enabled/default \
  && pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir -r /tmp/requirements.txt \
  && apt-get purge -y --auto-remove gcc python3-dev \
  && rm -rf /var/lib/apt/lists/* /tmp/requirements.txt

WORKDIR /app

COPY upstream/backend/requirements.txt /app/backend/requirements.txt
COPY upstream/backend/ /app/backend/
RUN printf 'APP_VERSION = "%s"\nBUILD_CODE = "%s"\nBUILD_COMMIT = "%s"\nBUILD_BRANCH = "%s"\nBUILD_CREATED = "%s"\n' \
    "$LANLENS_APP_VERSION" \
    "$LANLENS_BUILD_CODE" \
    "$LANLENS_BUILD_COMMIT" \
    "$LANLENS_BUILD_BRANCH" \
    "$LANLENS_BUILD_CREATED" \
    > /app/backend/version.py

COPY --from=frontend-builder /app/frontend/dist /app/frontend/dist

# ─── Enhancement layer ────────────────────────────────────────────────────────
COPY enhancements/runtime/auto_services_extension.py /app/backend/services/auto_services_extension.py
COPY enhancements/runtime/auto_services_api.py /app/backend/routers/auto_services_api.py
COPY enhancements/runtime/lanlens-auto-services-ui-v5.js /app/frontend/dist/lanlens-auto-services-ui-v5.js
COPY enhancements/runtime/patch_runtime.py /tmp/patch_runtime.py
RUN python /tmp/patch_runtime.py && rm -f /tmp/patch_runtime.py

COPY upstream/nginx/nginx.conf /etc/nginx/nginx.conf
COPY upstream/scripts/entrypoint.sh /entrypoint.sh
COPY upstream/scripts/render-nginx-config.sh /usr/local/bin/render-lanlens-nginx
RUN chmod +x /entrypoint.sh /usr/local/bin/render-lanlens-nginx

RUN printf '#!/bin/sh\nexec python /app/backend/cli/reset_password.py "$@"\n' \
    > /usr/local/bin/reset-password \
  && chmod +x /usr/local/bin/reset-password

VOLUME ["/data"]

ENV DB_PATH=/data/lanlens.db \
    SECRET_KEY="" \
    LANLENS_SECRET_KEY_FILE=/data/secret_key \
    DEFAULT_ADMIN_PASSWORD=admin \
    LANLENS_PORT=8089 \
    BACKEND_PORT=18089 \
    TZ=Asia/Shanghai \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANLENS_AUTO_DISCOVER_SERVICES=1

EXPOSE 8089

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD sh -c 'if python -c "import json,sys; data=json.load(open(\"/data/tls/config.json\")); sys.exit(0 if data.get(\"enabled\") else 1)" 2>/dev/null; then port=$(python -c "import json; print(json.load(open(\"/data/tls/config.json\")).get(\"port\") or \"${LANLENS_PORT:-8089}\")"); curl -kfs "https://localhost:${port}/api/health"; else curl -fs "http://localhost:${LANLENS_PORT:-8089}/api/health"; fi || exit 1'

ENTRYPOINT ["/entrypoint.sh"]
